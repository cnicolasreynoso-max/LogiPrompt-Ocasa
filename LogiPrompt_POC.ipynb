import openai
import json
import pandas as pd

# 1. CONFIGURACIÓN DE MODELOS
API_KEY = "TU_API_KEY_AQUI"
client = openai.OpenAI(api_key=API_KEY)

# 2. TÉCNICA: PROMPTING DIRIGIDO E ITERATIVO
# Este prompt fue refinado tras varias iteraciones para evitar alucinaciones
SYSTEM_PROMPT = """
Actúas como Analista de CX en Ocasa. 
Tu objetivo es analizar el reporte del chofer y devolver un JSON estricto.
Debes inferir la 'Urgencia' basándote en si el remito está en riesgo.
Categorías: TURNO_FALLIDO, AVISO_NO_CONSEGUIDO, SIN_REMITO.
"""

def motor_logiprompt(mensaje):
    ejemplos_few_shot = "Chofer: 'No hay nadie'\nSalida: {'categoria': 'AVISO_NO_CONSEGUIDO', 'remito_ok': true, 'urgencia': 'Baja'}"
    
    try:
        response = client.chat.completions.create(
            model="gpt-3.5-turbo",
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": f"{ejemplos_few_shot}\nMensaje real: {mensaje}"}
            ],
            temperature=0
        )
        return json.loads(response.choices[0].message.content)
    except:
        # Mock de respaldo por si no hay saldo 
        return {"categoria": "ANALISIS_SIMULADO", "remito_ok": True, "urgencia": "MEDIA"}

# 3. INTERFAZ DE USUARIO 
print("--- BIENVENIDO AL PANEL LOGIPROMPT OCASA ---")
msg = input("Ingrese reporte del chofer: ")
resultado = motor_logiprompt(msg)

# 4. INTEGRACIÓN CON DATOS 
# Creamos un histórico rápido para demostrar manejo de datos
data = {
    "Fecha": ["2026-03-01", "2026-03-02", "2026-03-13"],
    "Incidente": ["TURNO_FALLIDO", "SIN_REMITO", resultado['categoria']],
    "Prioridad": ["Media", "Alta", resultado['urgencia']]
}
df = pd.DataFrame(data)

print("\n--- HISTORIAL DE INCIDENTES (PROCESADO) ---")
print(df)
